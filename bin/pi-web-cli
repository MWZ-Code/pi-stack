#!/usr/bin/env python3
"""PI WEB control plane on this host (loopback). Grok Bots SSH here and run this."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

BASE = os.environ.get("PI_WEB_URL", "http://127.0.0.1:8504").rstrip("/")


def req(method: str, path: str, body: dict | None = None, timeout: float = 20) -> tuple[int, object]:
    data = None
    headers = {}
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    r = urllib.request.Request(BASE + path, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(r, timeout=timeout) as resp:
            raw = resp.read()
            code = resp.status
    except urllib.error.HTTPError as e:
        raw = e.read()
        code = e.code
    text = raw.decode("utf-8", "replace")
    if text.lstrip().startswith("<!") or text.lstrip().lower().startswith("<!doctype"):
        return code, {"ok": False, "error": "html_not_api", "path": path, "status": code}
    try:
        parsed = json.loads(text) if text.strip() else None
    except json.JSONDecodeError:
        parsed = {"ok": False, "error": "non_json", "status": code, "body": text[:500]}
    return code, parsed


def _cwd_hint_path(sid: str) -> Path:
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    key = hashlib.sha256(f"{BASE}\0{sid}".encode()).hexdigest()
    return cache / "pi-web-cli" / "session-cwds" / key


def _remember_cwd(sid: object, cwd: object) -> None:
    if not isinstance(sid, str) or not isinstance(cwd, str) or not os.path.isabs(cwd):
        return
    path = _cwd_hint_path(sid)
    try:
        if path.is_file() and path.read_text(encoding="utf-8") == cwd:
            return
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as temporary:
            try:
                temporary.write(cwd.encode("utf-8"))
                temporary.close()
                os.replace(temporary.name, path)
            finally:
                Path(temporary.name).unlink(missing_ok=True)
    except (OSError, UnicodeError):
        pass


def _resolve_cwd(sid: str, session_path: str) -> str | None:
    try:
        cwd = _cwd_hint_path(sid).read_text(encoding="utf-8")
        if os.path.isabs(cwd):
            return cwd
    except (OSError, UnicodeError):
        pass
    code, location = req("GET", f"{session_path}/location")
    if code != 200 or not isinstance(location, dict) or location.get("sessionId") != sid:
        return None
    project_id, workspace_id = location.get("projectId"), location.get("workspaceId")
    if not isinstance(project_id, str) or not isinstance(workspace_id, str):
        return None
    project = urllib.parse.quote(project_id, safe="")
    code, catalog = req("GET", f"/api/projects/{project}/workspaces")
    rows = catalog.get("workspaces") if code == 200 and isinstance(catalog, dict) else None
    if not isinstance(rows, list):
        return None
    paths = {row["path"] for row in rows if isinstance(row, dict) and row.get("id") == workspace_id
             and isinstance(row.get("path"), str) and os.path.isabs(row["path"])}
    return next(iter(paths)) if len(paths) == 1 else None


@dataclass
class SessionRef:
    sid: str
    cwd: str | None = None

    def request(self, method: str, suffix: str, body: dict | None = None, timeout: float = 20) -> tuple[int, object]:
        session_path = "/api/sessions/" + urllib.parse.quote(self.sid, safe="")
        path = session_path + (f"/{suffix}" if suffix else "")
        if self.cwd is None:
            code, data = req(method, path, body, timeout)
            missing = "cwd field must be a string" if method == "POST" else "cwd query parameter is required"
            # These errors are returned before dispatch. Never retry a failed or uncertain operation.
            if code != 400 or not isinstance(data, dict) or data.get("error") != missing:
                return code, data
            self.cwd = _resolve_cwd(self.sid, session_path)
            if self.cwd is None:
                return code, {**data, "hint": "Session cwd could not be resolved. Pass --cwd for the session."}
        if method == "POST":
            body = {**(body or {}), "cwd": self.cwd}
        else:
            path += "?" + urllib.parse.urlencode({"cwd": self.cwd})
        return req(method, path, body, timeout)


def out(obj: object, ok: bool) -> int:
    print(json.dumps(obj, indent=2))
    return 0 if ok else 1


def cmd_list(cwd: str | None) -> int:
    path = "/api/sessions"
    if cwd:
        path += "?" + urllib.parse.urlencode({"cwd": cwd})
    code, data = req("GET", path)
    ok = code == 200 and not (isinstance(data, dict) and data.get("error"))
    if ok and isinstance(data, list):
        for row in data:
            if isinstance(row, dict):
                _remember_cwd(row.get("id"), row.get("cwd"))
    return out({"ok": ok, "status": code, "sessions": data}, ok)


def cmd_spawn(cwd: str) -> int:
    code, data = req("POST", "/api/sessions", {"cwd": cwd})
    ok = code in (200, 201) and isinstance(data, dict) and "id" in data
    if ok:
        _remember_cwd(data["id"], data.get("cwd") or os.path.abspath(cwd))
    return out({"ok": ok, "status": code, "session": data}, ok)


def cmd_prompt(session: SessionRef, text: str, streaming: str | None = None) -> int:
    body = {"text": text} if streaming is None else {"text": text, "streamingBehavior": streaming}
    code, data = session.request("POST", "prompt", body)
    ok = code == 200 and isinstance(data, dict) and data.get("accepted") is True
    return out({"ok": ok, "status": code, "result": data}, ok)


def cmd_status(session: SessionRef) -> int:
    code, data = session.request("GET", "status")
    ok = code == 200 and isinstance(data, dict) and not data.get("error")
    return out({"ok": ok, "status": code, "session": data}, ok)


def cmd_commands(session: SessionRef) -> int:
    code, data = session.request("GET", "commands")
    ok = code == 200 and isinstance(data, list)
    return out({"ok": ok, "status": code, "commands": data}, ok)


class UsageError(Exception):
    pass


def _model_body(args: argparse.Namespace) -> dict[str, str]:
    provider, slash, model_id = args.model.partition("/")
    if slash == "" or provider == "" or model_id == "":
        raise UsageError("model must be provider/modelId")
    return {"provider": provider, "modelId": model_id}


def _answer_body(args: argparse.Namespace) -> dict[str, object]:
    # values holds option ids; free text goes in otherText.
    return {
        "askId": args.ask_id,
        "answers": [{"id": args.question_id, "values": [], "otherText": args.text}],
    }


VerbBuilder = Callable[[argparse.Namespace], dict | None]
VERBS: dict[str, tuple[str, str, tuple[str, ...], VerbBuilder]] = {
    "stop": ("POST", "stop", (), lambda _args: {}),
    "abort": ("POST", "abort", (), lambda _args: {}),
    "queue-clear": ("POST", "queue/clear", (), lambda _args: {}),
    "archive": ("POST", "archive", (), lambda _args: {}),
    "messages": ("GET", "messages", (), lambda _args: None),
    "model": ("POST", "model", ("model",), _model_body),
    "thinking-level": ("POST", "thinking-level", ("level",), lambda args: {"level": args.level}),
    "answer": ("POST", "ask/submit", ("ask_id", "question_id", "text"), _answer_body),
}


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(description="PI WEB control plane (127.0.0.1:8504)")
    sub = p.add_subparsers(dest="cmd", required=True)
    ls = sub.add_parser("list")
    ls.add_argument("--cwd", required=True, help="PI WEB requires cwd; global roster is pi-intercom-cli list")
    sp = sub.add_parser("spawn")
    sp.add_argument("cwd")
    pr = sub.add_parser("prompt")
    pr.add_argument("sid")
    pr.add_argument("text", nargs="?")
    behavior = pr.add_mutually_exclusive_group()
    behavior.add_argument("--steer", action="store_true")
    behavior.add_argument("--follow-up", action="store_true")
    st = sub.add_parser("status")
    st.add_argument("sid")
    cm = sub.add_parser("commands")
    cm.add_argument("sid")
    for name, (_method, _suffix, positionals, _build) in VERBS.items():
        verb = sub.add_parser(name)
        verb.add_argument("sid")
        for positional in positionals:
            verb.add_argument(positional)
    for verb in (pr, st, cm, *(sub.choices[name] for name in VERBS)):
        verb.add_argument("--cwd", help="exact session workspace, if it cannot be resolved by ID")
    args = p.parse_args(argv)
    if args.cmd == "list":
        return cmd_list(args.cwd)
    if args.cmd == "spawn":
        return cmd_spawn(args.cwd)
    session = SessionRef(args.sid, args.cwd)
    if args.cmd == "prompt":
        text = args.text if args.text is not None else sys.stdin.read()
        if not text.strip():
            return out({"ok": False, "error": "empty prompt"}, False)
        streaming = "steer" if args.steer else "followUp" if args.follow_up else None
        return cmd_prompt(session, text, streaming)
    if args.cmd == "status":
        return cmd_status(session)
    if args.cmd == "commands":
        return cmd_commands(session)
    method, suffix, _positionals, build = VERBS[args.cmd]
    try:
        body = build(args)
    except UsageError as exc:
        return out({"ok": False, "error": str(exc)}, False)
    code, data = session.request(method, suffix, body)
    ok = code == 200 and not (isinstance(data, dict) and data.get("error"))
    return out({"ok": ok, "status": code, "result": data}, ok)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
